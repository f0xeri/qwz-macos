From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: f0xeri <9pik.official@gmail.com>
Date: Sun, 18 Oct 2026 04:43:06 -0700
Subject: [PATCH] qwz: report an RDDM dump in the log instead of a file

After a firmware crash OpenBSD waits 30 s for userland and writes the
RAM dump to /root/qwz0-rddm.bin. A kext has no file system to write to
that early, so under QWZMAC the dump goes to qwzmac_rddm_report(),
which logs its size and the readable strings in it (assert messages,
file names).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sys/dev/pci/if_qwz_pci.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/sys/dev/pci/if_qwz_pci.c b/sys/dev/pci/if_qwz_pci.c
index 432bbdd3d2afda81f717973c48c917a736dad285..c591c4c78ce26fd5ed77e28fc48b8e72b4df3d1f 100644
--- a/sys/dev/pci/if_qwz_pci.c
+++ b/sys/dev/pci/if_qwz_pci.c
@@ -3568,11 +3568,13 @@ qwz_rddm_task(void *arg)
 	int i, timeout;
 	const uint32_t msecs = 2000, retries = 1000;
 	uint8_t *rddm;
+#ifndef QWZMAC /* QWZMAC: report the dump in the log instead of a file */
 	struct nameidata nd;
 	struct vnode *vp = NULL;
 	struct iovec iov[3];
 	struct uio uio;
 	char path[PATH_MAX];
+#endif
 	int error = 0;
 
 	if (psc->rddm_data == NULL) {
@@ -3604,6 +3606,9 @@ qwz_rddm_task(void *arg)
 	}
 	DPRINTF("\n");
 
+#ifdef QWZMAC /* QWZMAC: report the dump in the log instead of a file */
+	qwzmac_rddm_report(rddm, len);
+#else
 	DPRINTF("%s: sleeping for 30 seconds to allow userland to boot\n", __func__);
 	tsleep_nsec(&psc->rddm_data, 0, "qwzrddm", SEC_TO_NSEC(30));
 
@@ -3645,6 +3650,7 @@ qwz_rddm_task(void *arg)
 	if (error)
 		DPRINTF("%s: vn_close: error %d\n", __func__, error);
 	#endif
+#endif /* QWZMAC */
 done:
 	qwz_dmamem_free(sc->sc_dmat, psc->rddm_data);
 	qwz_dmamem_free(sc->sc_dmat, psc->rddm_vec);
