-	atomic_sub_long(&mbuf_mem_alloc, pp->pr_pgsize);
-	return (NULL);
-}
-
-void
-m_pool_free(struct pool *pp, void *v)
-{
-	(*pool_allocator_multi.pa_free)(pp, v);
