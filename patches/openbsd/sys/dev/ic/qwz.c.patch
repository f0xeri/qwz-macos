+	arg->peer_he_ops = (uint32_t)ni->ni_he_oper_params[0] |
+	    ((uint32_t)ni->ni_he_oper_params[1] << 8) |
+	    ((uint32_t)ni->ni_he_oper_params[2] << 16);
+
+	/*
+	 * 802.11ax-2022 26.6.1: with a non-zero A-MPDU length exponent
+	 * extension the maximum follows from it, else the VHT (or HT) one
+	 * computed by the earlier steps stays.
+	 */
+	factor = (ni->ni_he_mac_cap[3] & QWZ_HE_MAC3_MAX_AMPDU_EXP_MASK) >>
+	    QWZ_HE_MAC3_MAX_AMPDU_EXP_SHIFT;
+	if (factor != 0) {
+		if (ni->ni_flags & IEEE80211_NODE_VHT)
+			arg->peer_max_mpdu = (1U <<
+			    (QWZ_HE_VHT_MAX_AMPDU_FACTOR + factor)) - 1;
+		else if (ni->ni_flags & IEEE80211_NODE_HT)
+			arg->peer_max_mpdu = (1U <<
+			    (QWZ_HE_HT_MAX_AMPDU_FACTOR + factor)) - 1;
+	}
