+		    IEEE80211_HE_MCS_SS_NOT_SUPP) <<
+		    IEEE80211_HE_MCS_FOR_SS_SHIFT(ss);
+	}
+	ic->ic_he_rxmcs_80 = rxmap;
+	ic->ic_he_txmcs_80 = txmap;
+	ic->ic_flags |= IEEE80211_F_HEON;
+
+	DNPRINTF(QWZ_D_MAC, "%s: 802.11ax on, mac cap0 %02x phy cap0 %02x\n",
+	    __func__, ic->ic_he_mac_cap[0], ic->ic_he_phy_cap[0]);
+}
