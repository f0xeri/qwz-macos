+#ifdef QWZMAC
+/*
+ * net80211 recomputes the active channel set whenever the phy mode changes,
+ * and the 802.11ac mode it enters after joining a VHT access point holds only
+ * the 5 GHz VHT channels: beacons and probe responses on 2.4 GHz are then
+ * thrown away as "invalid channel" and a join to a 2.4 GHz network finds no
+ * candidate. In 802.11n mode every channel was active. The firmware scans all
+ * channels regardless (qwz_scan() walks ic_channels), so make net80211 accept
+ * what it finds: mark every channel the regulatory data allows as active.
+ */
+void
+qwz_chan_active_all(struct qwz_softc *sc)
+{
+	struct ieee80211com *ic = &sc->sc_ic;
+	int i;
+
+	for (i = 0; i <= IEEE80211_CHAN_MAX; i++)
+		if (ic->ic_channels[i].ic_flags != 0)
+			setbit(ic->ic_chan_active, i);
 }
 
+/*
+ * 802.11ac: an 80 MHz channel is four adjacent 20 MHz channels, and the
+ * regulatory rule of the primary channel alone says nothing about the other
+ * three. Keep VHT80 on a channel only if every channel of its block (36-48,
+ * 52-64, 100-112, 116-128, 132-144, 149-161, 165-177) exists and allows it.
+ */
+void
+qwz_vht_check_80mhz(struct qwz_softc *sc)
+{
+	struct ieee80211com *ic = &sc->sc_ic;
+	struct ieee80211_channel *chan, *blk;
+	int c, base, i, ok;
+
+	for (c = 36; c <= IEEE80211_CHAN_MAX; c++) {
+		chan = &ic->ic_channels[c];
+		if ((chan->ic_xflags & IEEE80211_CHANX_80MHZ) == 0)
+			continue;
+		if (c >= 149)
+			base = 149 + ((c - 149) / 16) * 16;
+		else if (c >= 100)
+			base = 100 + ((c - 100) / 16) * 16;
+		else
+			base = 36 + ((c - 36) / 16) * 16;
+		ok = (base + 12 <= IEEE80211_CHAN_MAX);
+		for (i = 0; ok && i < 4; i++) {
+			blk = &ic->ic_channels[base + 4 * i];
+			if (blk->ic_flags == 0 ||
+			    (blk->ic_xflags & IEEE80211_CHANX_80MHZ) == 0)
+				ok = 0;
+		}
+		if (!ok) {
+			/* The rest of the block then fails the same test. */
+			chan->ic_xflags &= ~IEEE80211_CHANX_80MHZ;
+			chan->ic_flags &= ~IEEE80211_CHAN_VHT;
+		}
+	}
+}
+#endif
