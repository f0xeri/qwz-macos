+	memset(ic->ic_he_phy_cap, 0, sizeof(ic->ic_he_phy_cap));
+	ic->ic_he_rxmcs_80 = ic->ic_he_txmcs_80 = 0xffff;
+	ic->ic_he_rxmcs_160 = ic->ic_he_txmcs_160 = 0;
+	ic->ic_he_rxmcs_80p80 = ic->ic_he_txmcs_80p80 = 0;
+	ic->ic_flags &= ~IEEE80211_F_HEON;
+
+	memcpy(mac, b5->he_cap_info, sizeof(mac));
+	memcpy(phy, b5->he_cap_phy_info, sizeof(phy));
+	for (i = 0; i < IEEE80211_HE_PHY_CAPS_LEN; i++)
+		any |= phy[i];
+
+	if (qwz_nohe || (pdev->cap.supported_bands & WMI_HOST_WLAN_5G_CAP) == 0 ||
+	    !any || (ic->ic_modecaps & (1 << IEEE80211_MODE_11AX)) == 0) {
+		printf("%s: 802.11ax off (nohe %u, bands 0x%x, fw he caps %s, "
+		    "modecaps 0x%x)\n", sc->sc_dev.dv_xname, qwz_nohe,
+		    pdev->cap.supported_bands, any ? "present" : "none",
+		    ic->ic_modecaps);
+		return;
+	}
+
+	memcpy(ic->ic_he_mac_cap, mac, IEEE80211_HE_MAC_CAPS_LEN);
+	memcpy(ic->ic_he_phy_cap, phy, IEEE80211_HE_PHY_CAPS_LEN);
+
+	ic->ic_he_mac_cap[0] &= ~(QWZ_HE_MAC0_TWT_REQ | QWZ_HE_MAC0_TWT_RES);
+	ic->ic_he_mac_cap[1] &= QWZ_HE_MAC1_TF_MAC_PAD_DUR_MASK;
+
+	w = phy[0] & QWZ_HE_PHY0_WIDTH_40_80_5G;
+	if ((pdev->cap.supported_bands & WMI_HOST_WLAN_2G_CAP) &&
+	    (((uint8_t *)b2->he_cap_phy_info)[0] & QWZ_HE_PHY0_WIDTH_40_2G))
+		w |= QWZ_HE_PHY0_WIDTH_40_2G;
+	ic->ic_he_phy_cap[0] = w;
+
+	ic->ic_he_phy_cap[5] &= ~QWZ_HE_PHY5_SND_DIM_UNDER_80_MASK;
+	ic->ic_he_phy_cap[5] |= MIN(MAX(sc->num_tx_chains, 1), 8) - 1;
+	ic->ic_he_phy_cap[6] &= ~QWZ_HE_PHY6_PPE_THRESHOLD_PRESENT;
+	ic->ic_he_phy_cap[9] &= ~QWZ_HE_PHY9_NOMINAL_PADDING_MASK;
+	ic->ic_he_phy_cap[9] |= QWZ_HE_PHY9_NOMINAL_PADDING_16US |
+	    QWZ_HE_PHY9_TX_1024_QAM_LT_242_RU;
