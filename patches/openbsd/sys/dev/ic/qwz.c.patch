+ */
+void
+qwz_peer_assoc_he(struct qwz_softc *sc, struct ieee80211_node *ni,
+    struct peer_assoc_params *arg)
+{
+	uint16_t rxmap = ni->ni_he_rxmcs_80, txmap = ni->ni_he_txmcs_80;
+	uint32_t factor;
+	int ss, nss = 0;
+
+	if ((ni->ni_flags & IEEE80211_NODE_HE) == 0)
+		return;
+
+	arg->he_flag = true;
+
+	/* Spatial streams: what the peer receives, and what we can send. */
+	for (ss = 1; ss <= IEEE80211_HE_NUM_SS; ss++) {
+		if (((rxmap & IEEE80211_HE_MCS_FOR_SS_MASK(ss)) >>
+		    IEEE80211_HE_MCS_FOR_SS_SHIFT(ss)) !=
+		    IEEE80211_HE_MCS_SS_NOT_SUPP)
+			nss = ss;
+	}
+	if (nss == 0)
+		nss = 1;
+	if (sc->num_tx_chains > 0 && nss > sc->num_tx_chains)
+		nss = sc->num_tx_chains;
+	arg->peer_nss = nss;
+
+	memcpy(arg->peer_he_cap_macinfo, ni->ni_he_mac_cap,
+	    MIN(sizeof(arg->peer_he_cap_macinfo), IEEE80211_HE_MAC_CAPS_LEN));
+	memcpy(arg->peer_he_cap_phyinfo, ni->ni_he_phy_cap,
+	    MIN(sizeof(arg->peer_he_cap_phyinfo), IEEE80211_HE_PHY_CAPS_LEN));
