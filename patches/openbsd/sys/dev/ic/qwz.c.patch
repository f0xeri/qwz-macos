+#ifdef QWZMAC
+/*
+ * QWZMAC: background scan (scan while associated), as in qwx(4)
+ * (qwx_bgscan_task(), qwx_bgscan()); qwz has none, so net80211 never
+ * refreshes its view of the other APs once associated, and a Wi-Fi menu
+ * only ever lists what was heard before the join. The firmware scan is
+ * the same WMI scan as in SCAN state; it leaves the channel for a while
+ * and comes back, the association stays up.
+ */
+void
+qwz_bgscan_task(void *arg)
+{
+	struct qwz_softc *sc = arg;
+	struct ieee80211com *ic = &sc->sc_ic;
+
+	if (ic->ic_state == IEEE80211_S_RUN &&
+	    sc->scan.state == ATH12K_SCAN_IDLE &&
+	    !test_bit(ATH12K_FLAG_CRASH_FLUSH, sc->sc_flags))
+		qwz_scan(sc, 1);
+
+	refcnt_rele_wake(&sc->task_refs);
+}
+
+int
+qwz_bgscan(struct ieee80211com *ic)
+{
+	struct ifnet *ifp = &ic->ic_if;
+	struct qwz_softc *sc = ifp->if_softc;
+
+	qwz_add_task(sc, systq, &sc->bgscan_task);
+
+	return 0;
+}
+
+/*
+ * QWZMAC: the scan found a better AP. qwx(4) roams to it
+ * (qwx_bgscan_done_task(): drain the Tx queues, delete the keys, tear the
+ * old association down in firmware, ieee80211_node_switch_bss()); that is
+ * not ported yet, so stay with the current AP, as net80211 does when the
+ * scan picks the same AP again (ieee80211_end_scan()).
+ */
+void
+qwz_bgscan_done(struct ieee80211com *ic,
+    struct ieee80211_node_switch_bss_arg *arg, size_t arg_size)
+{
+	struct ieee80211_node *ni = ic->ic_bss;
+
+	free(arg, M_DEVBUF, arg_size);
+	if (ic->ic_bgscan_fail < IEEE80211_BGSCAN_FAIL_MAX) {
+		if (ic->ic_bgscan_fail <= 0)
+			ic->ic_bgscan_fail = 1;
+		else
+			ic->ic_bgscan_fail *= 2;
+	}
+	ic->ic_xflags &= ~IEEE80211_F_TX_MGMT_ONLY;
+	ic->ic_flags &= ~IEEE80211_F_BGSCAN;
+	if (ni->ni_flags & IEEE80211_NODE_VHT)
+		ieee80211_setmode(ic, IEEE80211_MODE_11AC);
+	else if (ni->ni_flags & IEEE80211_NODE_HT)
+		ieee80211_setmode(ic, IEEE80211_MODE_11N);
+	else
+		ieee80211_setmode(ic, ieee80211_node_abg_mode(ic, ni));
+}
