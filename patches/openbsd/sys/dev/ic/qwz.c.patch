+	/* Up to 80 MHz only: one MCS/NSS set. */
+	arg->peer_he_mcs_count = 1;
+	arg->peer_he_rx_mcs_set[WMI_HECAP_TXRX_MCS_NSS_IDX_80] = rxmap;
+	arg->peer_he_tx_mcs_set[WMI_HECAP_TXRX_MCS_NSS_IDX_80] = txmap;
+
+	DNPRINTF(QWZ_D_MAC, "%s: he peer %s nss %d max_mpdu %u ops 0x%x "
+	    "rx mcs 0x%x tx mcs 0x%x\n", __func__,
+	    ether_sprintf(ni->ni_macaddr), nss, arg->peer_max_mpdu,
+	    arg->peer_he_ops, rxmap, txmap);
+}
