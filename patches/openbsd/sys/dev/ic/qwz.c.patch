+#ifdef QWZMAC
+/* QWZMAC: Airport-only counterpart of MediaTek's uni_add_dev(current MAC).
+ * Called under ioctl_rwl + spl after qwz_stop drains state/key/scan tasks.
+ * ath12k deletes and waits before reusing the ID and TX bank. Preserve all
+ * existing low-address DMA maps/rings; nothing is written to persistent storage. */
+int
+qwzmac_recreate_vdev(struct qwz_softc *sc, const uint8_t mac[6])
+{
+	struct qwz_vif *vif = &sc->sc_vif;
+	struct ieee80211com *ic = &sc->sc_ic;
+	struct wmi_vdev_delete_cmd *cmd;
+	struct mbuf *m;
+	uint64_t deadline, now;
+	int error, bank, id;
+	rw_assert_wrlock(&sc->ioctl_rwl);
+	if (sc->qwzmac_native_mac_fault) return EIO;
+	if (!memcmp(sc->qwzmac_vdev_mac, mac, 6)) {
+		IEEE80211_ADDR_COPY(ic->ic_myaddr, mac);
+		IEEE80211_ADDR_COPY(ic->ic_ac.ac_enaddr, mac);
+		return 0;
+	}
+	if (!sc->fw_initialized || sc->num_radios != 1 ||
+	    sc->num_created_vdevs != 1 || sc->num_started_vdevs != 0 ||
+	    sc->num_peers || !TAILQ_EMPTY(&sc->peers) ||
+	    (ic->ic_if.if_flags & IFF_RUNNING) || sc->scan.state != ATH12K_SCAN_IDLE)
+		return EBUSY;
+	id = vif->vdev_id;
+	if (id < 0 || id >= 32 || !(sc->allocated_vdev_map & (1U << id))) return EINVAL;
+	m = qwz_wmi_alloc_mbuf(sizeof(*cmd));
+	if (!m) return ENOMEM;
+	cmd = (void *)(mtod(m, uint8_t *) + sizeof(struct ath12k_htc_hdr) + sizeof(struct wmi_cmd_hdr));
+	cmd->tlv_header = FIELD_PREP(WMI_TLV_TAG, WMI_TAG_VDEV_DELETE_CMD) |
+	    FIELD_PREP(WMI_TLV_LEN, sizeof(*cmd) - TLV_HDR_SIZE);
+	cmd->vdev_id = id;
+	sc->qwzmac_vdev_delete_id = id;
+	sc->qwzmac_vdev_delete_done = 0;
+	printf("%s: native MAC: delete firmware vdev %d\n", sc->sc_dev.dv_xname, id);
+	error = qwz_wmi_cmd_send(&sc->wmi.wmi[sc->pdevs[0].pdev_id], m, WMI_VDEV_DELETE_CMDID);
+	if (error) { m_freem(m); goto fault; }
+	deadline = getnsecuptime() + SEC_TO_NSEC(3);
+	while (!sc->qwzmac_vdev_delete_done) {
+		now = getnsecuptime();
+		if (now >= deadline) { error = ETIMEDOUT; goto fault; }
+		error = tsleep_nsec(&sc->qwzmac_vdev_delete_done, 0, "qwzmac", deadline - now);
+		if (error && !sc->qwzmac_vdev_delete_done) goto fault;
+	}
+	sc->qwzmac_vdev_delete_id = -1;
+	/* ACK proves this vdev is gone. Do not release/reuse anything before it. */
+	qwz_vif_purge(sc);
+	bank = vif->bank_id;
+	if (bank >= 0 && bank < sc->dp.num_bank_profiles && sc->dp.bank_profiles[bank].num_users)
+		sc->dp.bank_profiles[bank].num_users--;
+	sc->allocated_vdev_map &= ~(1U << id);
+	sc->free_vdev_map |= 1U << id;
+	sc->num_created_vdevs--;
+	IEEE80211_ADDR_COPY(ic->ic_myaddr, mac);
+	IEEE80211_ADDR_COPY(ic->ic_ac.ac_enaddr, mac);
+	error = qwz_mac_op_add_interface(&sc->pdevs[0]);
+	if (error) goto fault;
+	printf("%s: native MAC: firmware vdev %u recreated as %s\n",
+	    sc->sc_dev.dv_xname, sc->sc_vif.vdev_id, ether_sprintf(mac));
+	return 0;
+fault:
+	sc->qwzmac_vdev_delete_id = -1;
+	sc->qwzmac_native_mac_fault = 1;
+	/* Unknown firmware ownership: never recycle the ID/DMA on timeout. */
+	if_down(&ic->ic_if);
+	printf("%s: native MAC reconfiguration failed %d; reboot required\n", sc->sc_dev.dv_xname, error);
+	return error;
+}
