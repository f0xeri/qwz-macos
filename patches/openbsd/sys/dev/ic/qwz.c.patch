+#ifdef QWZMAC
+/*
+ * 802.11ac: what we tell access points we can do, from the VHT capabilities
+ * the firmware reports (as ath12k_mac_setup_ht_vht_cap() does for mac80211).
+ * Called once the chain masks are known. We keep to 80 MHz, 802.11ac MCS 0-9,
+ * and receive-side beamforming only: no VHT160 or 80+80, no beamformer, no
+ * MU-MIMO.
+ */
+void
+qwz_mac_setup_vht_cap(struct qwz_softc *sc, struct qwz_pdev *pdev)
+{
+	struct ieee80211com *ic = &sc->sc_ic;
+	uint32_t vht_cap = pdev->cap.vht_cap;
+	uint16_t rxmap = 0, txmap = 0;
+	int ss;
+
+	ic->ic_vhtcaps = 0;
+	ic->ic_vht_rxmcs = ic->ic_vht_txmcs = 0xffff;	/* all not supported */
+	ic->ic_vht_rx_max_lgi_mbit_s = ic->ic_vht_tx_max_lgi_mbit_s = 0;
+	ic->ic_flags &= ~IEEE80211_F_VHTON;
+
+	if (qwz_novht || (pdev->cap.supported_bands & WMI_HOST_WLAN_5G_CAP) == 0 ||
+	    vht_cap == 0 || (ic->ic_modecaps & (1 << IEEE80211_MODE_11AC)) == 0) {
+		printf("%s: 802.11ac off (novht %u, bands 0x%x, fw vht cap 0x%x, "
+		    "modecaps 0x%x)\n", sc->sc_dev.dv_xname, qwz_novht,
+		    pdev->cap.supported_bands, vht_cap, ic->ic_modecaps);
+		return;
+	}
+
+	vht_cap &= ~(IEEE80211_VHTCAP_SU_BEAMFORMER |
+	    IEEE80211_VHTCAP_MU_BEAMFORMER | IEEE80211_VHTCAP_MU_BEAMFORMEE |
+	    IEEE80211_VHTCAP_NUM_STS_MASK);
+	if ((vht_cap & IEEE80211_VHTCAP_SU_BEAMFORMEE) == 0)
+		vht_cap &= ~IEEE80211_VHTCAP_BEAMFORMEE_STS_MASK;
+	vht_cap &= ~(IEEE80211_VHTCAP_CHAN_WIDTH_MASK |
+	    IEEE80211_VHTCAP_SGI160 | IEEE80211_VHTCAP_EXT_NSS_BW_MASK);
+	if (sc->num_tx_chains <= 1)
+		vht_cap &= ~IEEE80211_VHTCAP_TX_STBC;
+
+	for (ss = 1; ss <= IEEE80211_VHT_NUM_SS; ss++) {
+		rxmap |= (ss <= sc->num_rx_chains ? IEEE80211_VHT_MCS_0_9 :
+		    IEEE80211_VHT_MCS_SS_NOT_SUPP) <<
+		    IEEE80211_VHT_MCS_FOR_SS_SHIFT(ss);
+		txmap |= (ss <= sc->num_tx_chains ? IEEE80211_VHT_MCS_0_9 :
