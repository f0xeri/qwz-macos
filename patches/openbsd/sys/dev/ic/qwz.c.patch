+/* QWZMAC: native MAC recreation needs the firmware's delete acknowledgement.
+ * Match the ID before waking; malformed/late events cannot release a new vdev. */
+static void
+qwzmac_vdev_delete_event(struct qwz_softc *sc, struct mbuf *m)
+{
+	const void **tb = qwz_wmi_tlv_parse_alloc(sc, mtod(m, void *), m->m_pkthdr.len);
+	const struct wmi_vdev_delete_resp_event *ev;
+	if (tb == NULL) return;
+	ev = tb[WMI_TAG_VDEV_DELETE_RESP_EVENT];
+	if (ev && sc->qwzmac_vdev_delete_id >= 0 &&
+	    ev->vdev_id == (uint32_t)sc->qwzmac_vdev_delete_id) {
+		sc->qwzmac_vdev_delete_done = 1;
+		wakeup(&sc->qwzmac_vdev_delete_done);
+	}
+	free(tb, M_DEVBUF, WMI_TAG_MAX * sizeof(*tb));
+}
