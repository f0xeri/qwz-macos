diff --git a/Airport/macOS26/IO80211ControllerV2.h b/Airport/macOS26/IO80211ControllerV2.h
index 985a095..f7a2e88 100644
--- a/Airport/macOS26/IO80211ControllerV2.h
+++ b/Airport/macOS26/IO80211ControllerV2.h
@@ -143,8 +143,16 @@ class IO80211Controller : public IOEthernetController {
     OSDeclareAbstractStructors(IO80211Controller)
 public:
     IOReturn postMessage(IO80211SkywalkInterface *, unsigned int, void *, unsigned long, bool);
+#ifndef QWZAIRPORT
+    /*
+     * QWZAIRPORT: these two map MacKernelSDK's unused reserved slots 6 and 7 of
+     * IONetworkController onto the real methods. The macOS SDK we build with already
+     * declares those slots (allocatePacketNoWait, setHardwareAssists), so here they would be
+     * two new virtuals and shift every IO80211Controller slot by 2 (scripts/kc-abi.py --check).
+     */
     virtual void _RESERVEDIONetworkController6() __asm__("__ZN19IONetworkController20allocatePacketNoWaitEj");
     virtual void _RESERVEDIONetworkController7() __asm__("__ZN19IONetworkController18setHardwareAssistsEjj");
+#endif
     virtual void free();
     virtual bool init(OSDictionary*);
     virtual IOReturn configureReport(IOReportChannelList*, unsigned int, void*, void*);
diff --git a/Airport/macOS26/IO80211SkywalkInterface.h b/Airport/macOS26/IO80211SkywalkInterface.h
index 6e6949d..7e7ce3e 100644
--- a/Airport/macOS26/IO80211SkywalkInterface.h
+++ b/Airport/macOS26/IO80211SkywalkInterface.h
@@ -202,6 +202,9 @@ public:
     OSString *setInterfaceRole(unsigned int);
     void *setInterfaceId(unsigned int);
     int getInterfaceRole();
+    // QWZMAC: nonvirtual 25G241 IOUC->WCL router, checked against KC.
+    // setPOWER uses request 0x802869c8, command 19 and 24-byte power data.
+    SInt32 routeIoctlToWcl(unsigned int, unsigned int, void *, unsigned long);
 };
 static_assert(sizeof(IO80211SkywalkInterface) == 0x128, "WCL ABI size");
 #endif
